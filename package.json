{
  "name": "the-everything-harness",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.4.3",
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc",
    "test": "bun test",
    "build": "bun run --filter @everything-harness/cli build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.4.3",
    "typescript": "7.0.2"
  }
}
